### Create Publication - Songs from the Big Chair
POST http://localhost:8080/api/publications
Content-Type: application/json

{
  "name": "Songs from the Big Chair - Tears for Fears",
  "description": "Second studio album featuring the iconic hit Everybody Wants to Rule the World. Released in 1985, this album defined the sound of 80s synth-pop and new wave.",
  "albumName": "Songs from the Big Chair",
  "artist": "Tears for Fears",
  "genre": "Synth-pop",
  "releaseYear": 1985,
  "condition": "VERY_GOOD",
  "price": 34.99,
  "imageUris": [
    "https://upload.wikimedia.org/wikipedia/en/a/a1/Everybody_Wants_to_Rule_the_World.png?utm_source=en.wikipedia.org&utm_campaign=index&utm_content=thumbnail_unscaled&_=20231219215016"
  ]
}

